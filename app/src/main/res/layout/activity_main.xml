<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:background="@color/bg">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="BubbleBot Stealth" android:textColor="@color/text"
        android:textSize="22sp" android:textStyle="bold" />
    <TextView android:id="@+id/statusText" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="menghubungkan…" android:textColor="@color/muted" android:textSize="13sp" />
    <Button android:id="@+id/btnOverlayPerm" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="24dp"
        android:text="Aktifkan izin overlay" />
    <Button android:id="@+id/btnStart" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="Aktifkan service" />
    <Button android:id="@+id/btnStop" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="Matikan service" />
</LinearLayout>
